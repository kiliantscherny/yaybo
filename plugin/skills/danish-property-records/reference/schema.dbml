// Generated by scripts/generate_schema_dbml.py - do not edit by hand.
// The schema itself lives in src/yaybo/store.py (TABLES).
//
// Render at https://dbdiagram.io or https://dbdocs.io

Project yaybo {
  database_type: 'DuckDB'
  Note: '''
    Danish property records, fetched from tinglysning.dk, placed with
    DAWA and enriched from Danmarks Statistik.

    Every table joins back to ejendomme.uuid. Primary keys are real and
    enforced; the references below are documented but NOT enforced,
    because DuckDB cannot add a foreign key to an existing table.
  '''
}

Table ejendomme {
  uuid varchar [pk]
  adresse varchar
  lejlighed varchar
  ejendomstype varchar
  ejerlejlighedsnr varchar
  bfe_nr varchar
  areal_m2 bigint [note: 'the register\'s tinglyste areal, not the BBR living area - see boligareal_m2']
  opdelingsdato date
  fordelingstal varchar
  adkomst_dokumenttype varchar
  adkomst_dato_loebenummer varchar
  koebesum_dkk bigint
  overtagelsesdato date
  ejendomsvurdering_dkk bigint [note: 'public valuation, which sits well below market']
  grundvaerdi_dkk bigint
  vurderingsdato date
  kommune varchar
  kommunalt_ejendomsnr varchar
  landsejerlav varchar
  matrikel varchar
  grund_bfe varchar
  grund_areal_m2 bigint
  antal_haeftelser bigint
  antal_servitutter bigint
  adresse_uuid varchar
  boligtype varchar
  boligareal_m2 bigint [note: 'BBR living area, which is what a listing quotes. Not the same measure as areal_m2, the register\'s tinglyste areal. Needs a Datafordeler API key']
  breddegrad double
  laengdegrad double
  seneste_salg_dato date
  seneste_salg_dkk bigint
  seneste_salg_pris_m2 bigint [note: 'DERIVED: the newest transfer over the BBR living area. Empty without a Datafordeler API key']
  seneste_salg_pris_m2_tinglyst bigint [note: 'DERIVED: the same transfer over the register\'s own tinglyste areal, which needs no key']
  samlet_gaeld_dkk bigint [note: 'DERIVED: sum of the property\'s charges']
  frivaerdi_dkk bigint [note: 'DERIVED against the public valuation, so treat it as a floor']
  belaaningsgrad_pct double [note: 'DERIVED against the public valuation, so treat it as a ceiling']
  beriget boolean [note: 'whether this property was fetched by someone the register knew - per property, not per run']
  hentet timestamp [note: 'when this row was written']
  Note: 'One row per property. The centre of the schema: everything else joins back to ejendomme.uuid.'
}

Table ejere {
  ejendom_uuid varchar
  nummer bigint
  navn varchar
  foedselsdato date [note: 'needs a MitID login']
  cvr varchar
  andel varchar
  hentet timestamp [note: 'when this row was written']
  indexes {
    (ejendom_uuid, nummer) [pk]
  }
  Note: 'Who owns the property today.'
}

Table haeftelser {
  ejendom_uuid varchar
  dokument_uuid varchar
  dokument_version varchar
  adresse varchar
  dato_loebenummer varchar
  prioritet bigint
  rettighed_uuid varchar
  dokumenttype varchar
  dokumenttype_beskrivelse varchar
  formularkode varchar
  hovedstol varchar
  hovedstol_dkk bigint
  valuta varchar
  rentetype varchar
  rentesats_pct double
  reference_rente varchar
  reference_rente_pct double
  rente_margin_pct double
  rente_foreloebig boolean
  laantype varchar
  saerlige_vilkaar json
  kreditorbetegnelse varchar
  kreditorer varchar
  tinglysningsdato date
  senest_paategnet date
  overfoert boolean
  konverteret_pantebrev boolean
  afgift_dkk bigint
  afgift_overfoert boolean
  antal_respekt bigint
  antal_underpant bigint
  tekst varchar
  laantype_estimat varchar [note: 'ESTIMATED from DST rates, not recorded. The register gives a rate and never the product']
  laantype_afstand double [note: 'distance to the runner-up loan type; larger means more confident']
  laantype_alternativ varchar
  laantype_afgjort_af varchar
  laantype_kilde varchar
  hentet timestamp [note: 'when this row was written']
  indexes {
    (ejendom_uuid, dokument_uuid, dokument_version) [pk]
  }
  Note: 'Mortgages and charges, one row per document version. The same document can secure more than one charge, which is why the version is part of the key.'
}

Table servitutter {
  ejendom_uuid varchar
  dokument_uuid varchar
  dokument_version varchar
  adresse varchar
  dato_loebenummer varchar
  prioritet bigint
  rettighed_uuid varchar
  dokumenttype varchar
  indhold json
  tekst varchar
  paataleberettigede varchar
  ogsaa_lyst_paa bigint
  uden_ejers_tiltraedelse boolean
  prioritet_forud boolean
  betydning_for_vaerdi boolean
  tinglysningsdato date
  senest_paategnet date
  overfoert boolean
  afgift_dkk bigint
  akt_filnavn varchar
  hentet timestamp [note: 'when this row was written']
  indexes {
    (ejendom_uuid, dokument_uuid, dokument_version) [pk]
  }
  Note: 'Easements and covenants recorded against the property.'
}

Table dokument_parter {
  ejendom_uuid varchar
  dokument_uuid varchar
  dokumentart varchar
  rolle varchar
  nummer bigint [note: 'position within the role on one document, assigned after duplicate readings are merged']
  navn varchar
  foedselsdato date [note: 'needs a MitID login']
  cvr varchar
  andel varchar
  adresse_kode varchar
  hentet timestamp [note: 'when this row was written']
  indexes {
    (ejendom_uuid, dokument_uuid, dokumentart, rolle, nummer) [pk]
  }
  Note: 'Everyone named on any document, with their role. Needs a MitID login: this is the table the login is really for.'
}

Table underpant {
  ejendom_uuid varchar
  haeftelse_uuid varchar
  dokument_uuid varchar
  dato_loebenummer varchar
  rettighed_uuid varchar
  beloeb_dkk bigint
  valuta varchar
  prioritet bigint
  panthavere varchar
  hentet timestamp [note: 'when this row was written']
  indexes {
    (ejendom_uuid, haeftelse_uuid, rettighed_uuid) [pk]
  }
  Note: 'A mortgage deed pledged on in its own right - a charge on a charge.'
}

Table andele {
  uuid varchar [pk, note: 'the andelsboligbog\'s own uuid - a different register from ejendomme.uuid, and the two namespaces never mix']
  adresse varchar
  lejlighed varchar
  kommunekode varchar
  vejkode varchar
  ejendom_uuid varchar [note: 'the association\'s building in the tingbog, when the same lookup found exactly one. Empty otherwise']
  bygning_adresse varchar
  antal_haeftelser bigint
  antal_meddelelser bigint
  samlet_gaeld_dkk bigint [note: 'DERIVED: sum of what is charged against this share alone. NOT what living there owes - an andelshaver also owes a share of the association\'s own mortgage, which is against the building in the tingbog and is nowhere in this table']
  adresse_uuid varchar
  boligtype varchar [note: 'what BBR calls it. Needs a Datafordeler API key']
  boligareal_m2 bigint [note: 'BBR living area, and the only area a share has - the book records none. Needs a Datafordeler API key']
  breddegrad double
  laengdegrad double
  hentet timestamp [note: 'when this row was written']
  Note: 'One row per co-op share, from the andelsboligbog - a different book about a different thing. An andel is not real property, so it has no valuation, no matrikel and no area of its own; ejendom_uuid points at the association\'s building in the tingbog, which is where all of that is.'
}

Table andel_meddelelser {
  andel_uuid varchar
  dato_loebenummer varchar
  adresse varchar
  prioritet bigint
  dokumenttype varchar
  afgoerelsesdato date
  debitorer varchar [note: 'the andelshaver the notice concerns. The andelsboligbog has no owner register, so this is the nearest it comes to naming who lives there']
  disponenter varchar [note: 'whoever may act for them - an executor, a trustee']
  tillaegstekst varchar
  dokument_uuid varchar
  dokument_version varchar
  hentet timestamp [note: 'when this row was written']
  indexes {
    (andel_uuid, dato_loebenummer) [pk]
  }
  Note: 'Notices noted on a share - a death, a bankruptcy, a court removing the andelshaver\'s power to dispose of it. The only place this book names anyone other than a creditor.'
}

Table andel_haeftelser {
  andel_uuid varchar
  dokument_uuid varchar
  dokument_version varchar
  adresse varchar
  dato_loebenummer varchar
  prioritet bigint
  dokumenttype varchar
  hovedstol varchar
  hovedstol_dkk bigint
  rentetype varchar
  rentesats_pct double
  kreditorer varchar
  hentet timestamp [note: 'when this row was written']
  indexes {
    (andel_uuid, dokument_uuid, dokument_version) [pk]
  }
  Note: 'Charges registered against one share. The same fields the tingbog uses for a property\'s mortgages, under a different key.'
}

Table handelshistorik {
  ejendom_uuid varchar
  adresse varchar
  dato date
  beloeb_dkk bigint
  areal_m2 bigint
  boligareal_m2 bigint
  pris_pr_m2 bigint [note: 'DERIVED over the BBR living area, which is the measure a listing quotes. Empty without a Datafordeler API key']
  pris_pr_m2_tinglyst bigint [note: 'DERIVED over the register\'s own tinglyste areal. The two are not the same measure and can differ a lot']
  handelstype varchar
  registrering_id varchar
  hentet timestamp [note: 'when this row was written']
  indexes {
    (ejendom_uuid, registrering_id) [pk]
  }
  Note: 'Every recorded transfer read as a sale, out of the register\'s own historisk adkomst. The same transfers as adkomsthistorik, read for the money rather than the people. Needs a MitID login.'
}

Table bygninger {
  ejendom_uuid varchar
  adresse varchar
  bygning_nr varchar
  bygningstype varchar
  opfoerelsesaar bigint
  ombygningsaar bigint
  etager bigint
  vaerelser bigint
  badevaerelser bigint
  toiletter bigint
  boligareal_m2 bigint
  kaelderareal_m2 bigint
  erhvervsareal_m2 bigint
  andet_areal_m2 bigint
  samlet_areal_m2 bigint
  ydervaeg varchar
  tagdaekning varchar
  varmeinstallation varchar
  supplerende_varme varchar
  koekken varchar
  badeforhold varchar
  toiletforhold varchar
  hentet timestamp [note: 'when this row was written']
  indexes {
    (ejendom_uuid, bygning_nr) [pk]
  }
  Note: 'The BBR record for the building: year built, rooms, walls, heating. The land register says none of this. Filled from BBR via Datafordeleren, which needs a free API key; empty without one.'
}

Table adkomsthistorik {
  ejendom_uuid varchar
  post_nummer bigint
  adresse varchar
  dato date
  dokumenttype varchar
  koebesum_dkk bigint
  antal_ejere bigint
  historiske_ejere varchar
  hentet timestamp [note: 'when this row was written']
  indexes {
    (ejendom_uuid, post_nummer) [pk]
  }
  Note: 'Past transfers of the property. Needs a MitID login.'
}

Table adkomsthistorik_ejere {
  ejendom_uuid varchar
  post_nummer bigint
  dato date
  nummer bigint
  navn varchar
  foedselsdato date
  cvr varchar
  andel varchar
  note varchar
  hentet timestamp [note: 'when this row was written']
  indexes {
    (ejendom_uuid, post_nummer, nummer) [pk]
  }
  Note: 'The people named in each past transfer. Needs a MitID login.'
}

Table rentestatistik {
  maaned varchar
  rentfix_kode varchar
  laantype varchar
  effektiv_rente_pct double
  bidrag_pct double
  kupon_pct double
  hentet timestamp [note: 'when this row was written']
  indexes {
    (maaned, rentfix_kode) [pk]
  }
  Note: 'What each kind of realkredit loan cost, month by month, from Danmarks Statistik. Not about any one property - it is the series laantype_estimat was matched against, kept so an estimate can be checked.'
}

Table attester {
  ejendom_uuid varchar [pk]
  adresse varchar
  format varchar
  dokument varchar [note: 'the bytes the register signed']
  dokument_json json [note: 'the same content as queryable JSON, with the namespace prefixes dropped']
  hentet timestamp [note: 'when this row was written']
  Note: 'The property\'s whole register document, as signed and as queryable JSON. Needs a MitID login.'
}

Ref: ejere.ejendom_uuid > ejendomme.uuid
Ref: haeftelser.ejendom_uuid > ejendomme.uuid
Ref: servitutter.ejendom_uuid > ejendomme.uuid
Ref: bygninger.ejendom_uuid > ejendomme.uuid
Ref: handelshistorik.ejendom_uuid > ejendomme.uuid
Ref: adkomsthistorik.ejendom_uuid > ejendomme.uuid
Ref: dokument_parter.ejendom_uuid > ejendomme.uuid
Ref: underpant.ejendom_uuid > ejendomme.uuid
Ref: attester.ejendom_uuid - ejendomme.uuid
Ref: underpant.haeftelse_uuid > haeftelser.dokument_uuid
Ref: andele.ejendom_uuid > ejendomme.uuid
Ref: andel_haeftelser.andel_uuid > andele.uuid
Ref: andel_meddelelser.andel_uuid > andele.uuid

// dokument_parter.dokument_uuid points at haeftelser.dokument_uuid OR
// servitutter.dokument_uuid, and dokument_parter.dokumentart says which
// ('haeftelse', 'servitut', 'adkomst', 'underpant'). DBML cannot express a
// reference whose target depends on another column, so it is written here.
//
// adkomsthistorik_ejere joins adkomsthistorik on BOTH ejendom_uuid and
// post_nummer.
Ref: adkomsthistorik_ejere.(ejendom_uuid, post_nummer) > adkomsthistorik.(ejendom_uuid, post_nummer)
