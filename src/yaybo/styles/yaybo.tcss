/* ── yaybo ───────────────────────────────────────────────────────────── */

Screen {
    background: $background;
}

Header { dock: top; }
Footer { dock: bottom; }

/* ── tables ──────────────────────────────────────────────────────────── */

DataTable {
    height: 1fr;
}

DataTable > .datatable--header {
    text-style: bold;
    background: $primary 15%;
    color: $text;
}

DataTable > .datatable--cursor {
    background: $secondary 30%;
    color: $text;
}

DataTable > .datatable--hover {
    background: $primary 8%;
}

/* ── bars along the top of a screen ──────────────────────────────────── */

/* Not docked: two widgets docked to the same edge overlap rather than
   stacking, and every screen here wants a bar, then a status line, then the
   content. Composed in that order, the screen's own vertical layout does it. */
#library-bar, #queue-bar, #sql-bar {
    height: auto;
    min-height: 3;
    padding: 0 1;
    background: $panel;
    border-bottom: solid $primary 20%;
}

#library-bar Input, #queue-bar Input {
    width: 1fr;
    margin: 0 1 0 0;
}

#queue-bar Button {
    width: auto;
    min-width: 12;
    margin: 0 0 0 1;
}

#library-count {
    width: auto;
    min-width: 16;
    color: $text-muted;
    content-align: right middle;
    padding: 1 1 0 1;
}

/* ── search ──────────────────────────────────────────────────────────── */

#search-input {
    height: 3;
    margin: 1 2 0 2;
}

#search-status {
    height: auto;
    padding: 1 3;
    color: $secondary;
}

#search-matches, #search-units {
    margin: 0 2 1 2;
    border: round $primary 30%;
    background: $surface;
}

#search-matches {
    height: auto;
    max-height: 1fr;
}

/* Always long enough to be worth its own scroll: a building can hold a
   hundred properties, and the list is the whole point of the screen. */
#search-units {
    height: 1fr;
}

/* Textual draws the same glyph for a ticked and an unticked row and only
   changes its colour, which across a hundred rows is no difference at all.
   Empty reads as a blank swatch, ticked as a solid one. */
#search-units > .selection-list--button {
    color: $surface;
    background: $surface;
}

#search-units > .selection-list--button-highlighted {
    color: $surface;
    background: $surface;
}

#search-units > .selection-list--button-selected {
    color: $background;
    background: $success;
}

#search-units > .selection-list--button-selected-highlighted {
    color: $background;
    background: $success;
}

/* ── property ────────────────────────────────────────────────────────── */

#property-title {
    width: 100%;
    height: auto;
    padding: 0 2;
    background: $panel;
    border-bottom: solid $primary 20%;
}

TabbedContent { height: 1fr; }
ContentSwitcher { height: 1fr; }
TabPane { height: 1fr; padding: 0; }

Underline > .underline--bar { color: $primary 40%; }
Tab.-active { color: $text; text-style: bold; }
Tab:hover { color: $secondary; }

#overview, #bygning {
    height: 1fr;
    padding: 1 2;
}

.section-heading {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
    padding: 0 1;
    text-style: bold;
    color: $primary;
    background: $primary 12%;
}

.facts {
    width: 100%;
    height: auto;
    padding: 1 1 0 1;
}

/* Two tables share the Hæftelser pane, so neither may claim the height. */
#tab-haeftelser DataTable {
    height: auto;
    max-height: 24;
}

#chart {
    height: 1fr;
    min-height: 12;
}

#dokument {
    height: 1fr;
}

/* ── queue ───────────────────────────────────────────────────────────── */

#queue-status {
    height: auto;
    padding: 1 2;
    color: $secondary;
}

#queue-progress {
    height: 1;
    margin: 0 2 1 2;
}

/* ── sql ─────────────────────────────────────────────────────────────── */

#sql-snippets {
    width: 40;
    margin: 0 1 0 0;
}

#sql-hint {
    width: 1fr;
    color: $text-muted;
    content-align: right middle;
    padding: 1 1 0 0;
}

#sql-query {
    height: 12;
    border: round $primary 30%;
    margin: 1 1 0 1;
}

#sql-status {
    height: auto;
    padding: 0 2;
    color: $secondary;
}

#sql-results {
    height: 1fr;
}

/* ── export dialog ───────────────────────────────────────────────────── */

ExportDialog {
    align: center middle;
}

#export-box {
    width: 60;
    height: auto;
    padding: 1 2;
    border: thick $primary 60%;
    background: $surface;
}

#export-title {
    width: 100%;
    text-align: center;
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

#export-summary {
    width: 100%;
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

#export-note {
    width: 100%;
    height: auto;
    color: $warning;
}

#export-buttons {
    width: 100%;
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

#export-buttons Button {
    margin-left: 1;
}

/* ── shared odds and ends ────────────────────────────────────────────── */

.empty-state {
    width: 100%;
    height: 1fr;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
    text-style: italic;
}

.hint-text {
    width: 100%;
    height: auto;
    padding: 1 2;
    color: $text-muted;
    text-style: italic;
}

LoadingIndicator {
    color: $primary;
}
